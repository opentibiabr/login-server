# Copy this file to .env and adjust values for your environment.

# Canary root path
SERVER_PATH=C:/canary

# Database
MYSQL_DBNAME=canary
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=canary
MYSQL_PASS=canary

# Logging
ENV_LOG_LEVEL=debug
ENV_LOG_FILE=logs/login-server.txt

# Login-server endpoints
LOGIN_IP=127.0.0.1
LOGIN_HTTP_PORT=80
LOGIN_GRPC_PORT=9090
# Show accounts without paid time as free premium in the client character list (set it when the game server
# runs with freePremium = true). Leave empty or false to show them as free accounts.
LOGIN_FREE_PREMIUM=
# Replace SHA-1 account passwords with Argon2id when their owners log in. Enable only after the game server and the
# account website accept Argon2id. The database user needs UPDATE on accounts.password.
LOGIN_PASSWORD_REHASH=false
# Message shown to accounts flagged with accounts.password_change_required (ignored when the column does not exist).
# Leave empty for the default message.
LOGIN_PASSWORD_CHANGE_MESSAGE=
# Simultaneous Argon2id computations, 64 MiB each. Use 1 on a service limited to 256 MiB.
LOGIN_PASSWORD_HASH_CONCURRENCY=2
# Comma-separated IP/CIDR allowlist for proxies permitted to send forwarding headers.
# Leave empty for direct client connections.
LOGIN_TRUSTED_PROXIES=
RATE_LIMITER_BURST=5
RATE_LIMITER_RATE=2

# Base64-encoded 32-byte key shared with the account website.
# Required at startup so two-factor authentication cannot be deployed partially.
AUTHENTICATOR_ENCRYPTION_KEY=

# Game server
SERVER_IP=127.0.0.1
SERVER_NAME=OTServBR-Global
SERVER_PORT=7172
SERVER_LOCATION=BRA
# World PvP type shown by the client: a worldType name (retro-pvp, pvp, no-pvp, pvp-enforced, ...) or a code 0-4.
# Leave empty to read worldType from the config.lua of SERVER_PATH.
SERVER_PVP_TYPE=
